{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Renovate config preset for Šimon Hradní personal projects. Aggressive auto-merge — all patch + minor go through without manual gate, majors require review. Repos extend this via {\"extends\": [\"local>Gillellbor/.github\"]}.",
  "extends": [
    "config:recommended",
    "schedule:earlyMondays",
    ":semanticCommits",
    ":dependencyDashboard",
    "group:monorepos",
    "group:recommended",
    ":enablePreCommit",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Prague",
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "rebaseWhen": "auto",
  "prHourlyLimit": 4,
  "prConcurrentLimit": 10,
  "dependencyDashboardTitle": "🤖 Renovate dependency dashboard",
  "platformAutomerge": true,
  "automergeStrategy": "squash",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["dependencies", "security"],
    "schedule": ["at any time"],
    "prPriority": 10,
    "automerge": true
  },
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "Auto-merge ALL patch updates on green CI",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Auto-merge ALL minor updates on green CI",
      "matchUpdateTypes": ["minor"],
      "automerge": true
    },
    {
      "description": "Auto-merge devDependencies major updates too — lower blast radius, CI catches real breaks",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["major"],
      "automerge": true
    },
    {
      "description": "Group all linting/formatting tools in one PR",
      "matchPackageNames": [
        "eslint",
        "prettier",
        "biome",
        "@biomejs/biome",
        "@typescript-eslint/eslint-plugin",
        "@typescript-eslint/parser",
        "eslint-config-next"
      ],
      "groupName": "linters and formatters"
    },
    {
      "description": "Group Next.js + React core together (they often release in sync)",
      "matchPackageNames": [
        "next",
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "groupName": "Next.js + React core"
    },
    {
      "description": "Group all Radix UI packages (shadcn/ui dependencies)",
      "matchPackageNames": ["/^@radix-ui/.*/"],
      "groupName": "Radix UI"
    },
    {
      "description": "Group Tailwind ecosystem",
      "matchPackageNames": [
        "tailwindcss",
        "@tailwindcss/typography",
        "@tailwindcss/forms",
        "@tailwindcss/postcss",
        "tailwind-merge",
        "tailwindcss-animate",
        "clsx",
        "class-variance-authority"
      ],
      "groupName": "Tailwind ecosystem"
    },
    {
      "description": "Group Supabase clients",
      "matchPackageNames": ["/^@supabase/.*/"],
      "groupName": "Supabase clients"
    },
    {
      "description": "Group AI SDK packages",
      "matchPackageNames": [
        "ai",
        "@ai-sdk/anthropic",
        "@ai-sdk/openai",
        "@ai-sdk/react",
        "@ai-sdk/google"
      ],
      "groupName": "AI SDK"
    },
    {
      "description": "Pin GitHub Actions to full SHA (post-tj-actions CVE-2025-30066 hardening)",
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "automerge": true
    },
    {
      "description": "Major production deps — require manual review",
      "matchUpdateTypes": ["major"],
      "matchDepTypes": ["dependencies"],
      "automerge": false,
      "labels": ["dependencies", "major-update", "needs-review"]
    },
    {
      "description": "Special-case Next.js + React major — always manual (breaking by definition)",
      "matchPackageNames": ["next", "react", "react-dom"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major-update", "framework-upgrade", "needs-review"]
    }
  ],
  "github-actions": {
    "enabled": true,
    "pinDigests": true
  },
  "docker": {
    "enabled": true
  },
  "nvm": {
    "enabled": true
  },
  "npm": {
    "minimumReleaseAge": "3 days"
  }
}
